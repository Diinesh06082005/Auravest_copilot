# ==============================================================================
# AI Investment Research Copilot - Backend Environment Configuration Example
# ==============================================================================

# Application Environment
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (e.g., mongodb://localhost:27017/ai_investment_copilot)
MONGODB_URI=mongodb://localhost:27017/ai_investment_copilot

# Secret keys for signing JWT tokens (use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (for authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Layer Configurations
# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key

# CORS Configuration
# Allowed origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Third Party Data API Keys
FMP_API_KEY=your_fmp_api_key_here
NEWS_API_KEY=your_news_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
